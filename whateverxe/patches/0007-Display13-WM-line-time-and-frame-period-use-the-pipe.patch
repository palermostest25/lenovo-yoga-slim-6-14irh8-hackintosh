From ba4f04812a2a336347f23021f1ca7767c9993ceb Mon Sep 17 00:00:00 2001
From: retropineaple <118107729+retropineaple@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:10:48 +0100
Subject: [PATCH 07/11] Display13 WM: line time and frame period use the pipe's
 base pixel clock

WM_LINETIME and the frame period must follow the pipe's own pixel clock, the
native base at path+0x118, doubled per fb+0x425c. They were taken from the rate
adjustPixelClockForWatermarks raises by the pipe-scaler downscale ratio, which
is the rate for plane watermarks, as in i915. Without a downscale the two are
equal, so a native-size mode computes what it did before.

Originally https://github.com/retropineaple/WhateverXe/commit/516a760, behind
its panel option; here on every path, since the value does not change without
a downscale.

Co-authored-by: thatisjigen <55486333+Thatisjigen@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 WhateverXe/kern_xe.cpp        | 15 +++++++++++++--
 tests/display13_dbuf_setup.py |  3 ++-
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/WhateverXe/kern_xe.cpp b/WhateverXe/kern_xe.cpp
index ed6cd77..4d126c9 100644
--- a/WhateverXe/kern_xe.cpp
+++ b/WhateverXe/kern_xe.cpp
@@ -9568,6 +9568,17 @@ void XE::adlnWMSetup(OSObject *plane,OSObject *path,bool cursor) {
 void XE::wrapAlderLakeNPlaneWMSetup(OSObject *plane,OSObject *path) {adlnWMSetup(plane,path,false);}
 void XE::wrapDisplay13CursorWMSetup(OSObject *plane,OSObject *path) {adlnWMSetup(plane,path,true);}
 
+// WM_LINETIME and the frame period follow the pipe's own pixel clock (native
+// base at path+0x118, doubled per fb+0x425c), not the rate that
+// adjustPixelClockForWatermarks raises by the pipe-scaler downscale ratio (i915).
+// Without a downscale the two are equal, so a native-size mode is unchanged.
+static uint64_t display13LineTimePixel(IOService *fb,OSObject *path,uint64_t adjusted) {
+	if(!fb || !path || fb->getMetaClass()->getClassSize()<0x4B90 ||
+	   path->getMetaClass()->getClassSize()<0x3730)return adjusted;
+	auto base=Display13FBMemory::field<uint64_t>(path,0x118);
+	if(Display13FBMemory::field<uint8_t>(fb,0x425c))base*=2;
+	return base && base<=adjusted ? base : adjusted;
+}
 void XE::wrapAlderLakeNPipeWMSetup(IOService *controller,IOService *fb,OSObject *path,void *params) {
 	auto &c=display13FBPower;if(!c.lock)return;
 	uint64_t record[8] {};IOLockLock(c.lock);
@@ -9591,7 +9602,7 @@ void XE::wrapAlderLakeNPipeWMSetup(IOService *controller,IOService *fb,OSObject
 		auto crtc=params ? params : reinterpret_cast<uint8_t *>(path)+0x128;
 		const auto htotal=((Display13FBMemory::field<uint32_t>(crtc,0x10)>>16)&0x3FFF)+1;
 		auto adjust=reinterpret_cast<uint64_t (*)(void *,void *,void *,bool,void *)>(callbackXE->adlnAdjustPixelClock);
-		const auto pixel=adjust(controller,fb,path,true,crtc);
+		const auto pixel=display13LineTimePixel(fb,path,adjust(controller,fb,path,true,crtc));
 		const auto value=Display13WM::pipeLineTime(htotal,pixel);
 		*reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(crtc)+0x84)=value;
 		if(!value)adlnFault(c.watermarkFaulted,__LINE__);
@@ -9801,7 +9812,7 @@ Display13WM::Latch XE::adlnVerifyWMLatch(IOService *fb,uint64_t nativeHz,uint64_
 		void delayUs(unsigned us) {IOSleep(us/1000);}
 	} io {c.map};
 	auto adjust=reinterpret_cast<uint64_t (*)(void *,void *,void *,bool,void *)>(callbackXE->adlnAdjustPixelClock);
-	const auto pipePixel=adjust(c.controller,fb,path,true,nullptr);
+	const auto pipePixel=display13LineTimePixel(fb,path,adjust(c.controller,fb,path,true,nullptr));
     const auto primaryRaw=Display13DBUF::hardwareRaw(c.dbuf,pipe,c.dbuf.pipe[pipe].primary);
     const auto cursorRaw=Display13DBUF::hardwareRaw(c.dbuf,pipe,c.dbuf.pipe[pipe].cursor);
     if(primaryRaw==UINT32_MAX || cursorRaw==UINT32_MAX) {result.status=Display13WM::Status::Input;return result;}
diff --git a/tests/display13_dbuf_setup.py b/tests/display13_dbuf_setup.py
index e6b554c..c861ffc 100644
--- a/tests/display13_dbuf_setup.py
+++ b/tests/display13_dbuf_setup.py
@@ -8,7 +8,8 @@ s = read_source(r/'WhateverXe/kern_xe.cpp')
 guard = re.search(r'bool XE::dsiSharedWriterStopped\(.*?\n\}', s, re.S).group()
 body = re.search(r'void XE::adlnSetupDBUFPipe\(.*?\n\}', s, re.S).group()
 pipewm = re.search(r'void XE::wrapAlderLakeNPipeWMSetup\(.*?\n\}', s, re.S).group()
-code = (r / 'tests/display13_dbuf_setup_fixture.cpp').read_text().replace('// PRODUCTION_SETUP', guard+'\n'+body+'\n'+pipewm)
+linetime = re.search(r'static uint64_t display13LineTimePixel\(.*?\n\}', s, re.S).group()
+code = (r / 'tests/display13_dbuf_setup_fixture.cpp').read_text().replace('// PRODUCTION_SETUP', guard+'\n'+body+'\n'+linetime+'\n'+pipewm)
 with tempfile.TemporaryDirectory(prefix='dbuf-setup-') as d:
     p = Path(d)
     (p / 'test.cpp').write_text(code)
