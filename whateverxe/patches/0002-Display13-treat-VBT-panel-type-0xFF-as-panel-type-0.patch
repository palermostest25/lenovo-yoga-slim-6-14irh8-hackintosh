From 95fc6fecbac0afc6e4ac4dda7d537cfd8bb4c27a Mon Sep 17 00:00:00 2001
From: nickk19 <nikko8204@gmail.com>
Date: Thu, 5 Nov 2026 16:27:36 +0000
Subject: [PATCH 02/11] Display13: treat VBT panel type 0xFF as panel type 0

BDB 40 panel type 0xFF asks the driver to select the panel by its EDID
PnP ID. The EDID is not available when the VBT is parsed, so panelFacts
rejected the table and the internal panel's facts (DDI, low swing, HOBL)
were lost. Like i915 without an OpRegion or PnP match, use panel type 0.
Seen on the Lenovo IdeaPad Slim 5 14IAH8 (Alder Lake-H, 46A3).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 WhateverXe/kern_vbt.hpp  | 6 ++++--
 tests/firmware_ports.cpp | 9 ++++++++-
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/WhateverXe/kern_vbt.hpp b/WhateverXe/kern_vbt.hpp
index a8022a2..7a0ccec 100644
--- a/WhateverXe/kern_vbt.hpp
+++ b/WhateverXe/kern_vbt.hpp
@@ -107,7 +107,9 @@ inline void panelFacts(const uint8_t *b,size_t header,size_t size,Ports &ports)
         if(b[at]==44){duplicate|=power!=nullptr;power=block;powerSize=n;}
         at+=3+n;
     }
-    if(duplicate || !options || optionsSize<1 || options[0]>=16 ||
+    // BDB 40 panel type 0xFF selects the panel by EDID PnP ID. The EDID is not
+    // available this early; like i915 without an OpRegion or PnP match, use 0.
+    if(duplicate || !options || optionsSize<1 || (options[0]>=16 && options[0]!=0xFF) ||
        !edp || edpSize<212 || (ports.version>=232 && (!power || powerSize<56)))return;
     unsigned internal=PortCount;
     for(unsigned d=0;d<PortCount;++d)if((ports.present&(1U<<d)) &&
@@ -117,7 +119,7 @@ inline void panelFacts(const uint8_t *b,size_t header,size_t size,Ports &ports)
     }
     if(internal==PortCount)return;
     auto &p=ports.panel;
-    p.type=options[0];p.ddi=internal;
+    p.type=options[0]==0xFF?0:options[0];p.ddi=internal;
     p.lowSwing=((u64(edp+204)>>(4*p.type))&15)==0;
     p.hobl=ports.version>=232 && (u16(power+54)&(1U<<p.type));
     p.valid=true;
diff --git a/tests/firmware_ports.cpp b/tests/firmware_ports.cpp
index be3f2d0..12df529 100644
--- a/tests/firmware_ports.cpp
+++ b/tests/firmware_ports.cpp
@@ -145,9 +145,16 @@ int main(int argc,char **argv){
   auto q=parse(b.data(),b.size(),Family::TigerLake);
   assert(q.panel.valid&&q.panel.lowSwing&&q.panel.hobl&&q.panel.type==n);
  }
+ {
+  // 0xFF (select by EDID PnP ID) falls back to panel type 0, as i915 does
+  // without an OpRegion or PnP match.
+  auto b=panelTable;b[options]=255;
+  auto q=parse(b.data(),b.size(),Family::TigerLake);
+  assert(q.valid()&&q.hdmi(3).hdmi==2&&q.panel.valid&&q.panel.type==0&&q.panel.ddi==0);
+ }
  for(unsigned bad=0;bad<5;++bad) {
   auto b=panelTable;
-  if(bad==0)b[options]=255;
+  if(bad==0)b[options]=254;
   if(bad==1)w16(b,edp-2,211);
   if(bad==2)w16(b,power-2,55);
   if(bad==3)append(b,40,1);
